#include <stdio.h>

int board[20][20];
int n;

int isSafe(int row,int col)
{
    int i,j;

    for(i=0;i<row;i++)
    {
        if(board[i][col])
            return 0;
    }

    for(i=row,j=col;
        i>=0 && j>=0;
        i--,j--)
    {
        if(board[i][j])
            return 0;
    }

    for(i=row,j=col;
        i>=0 && j<n;
        i--,j++)
    {
        if(board[i][j])
            return 0;
    }

    return 1;
}

void solve(int row)
{
    if(row==n)
    {
        printf("\nSolution:\n");

        for(int i=0;i<n;i++)
        {
            for(int j=0;j<n;j++)
            {
                printf("%d ",
                       board[i][j]);
            }

            printf("\n");
        }

        return;
    }

    for(int col=0;col<n;col++)
    {
        if(isSafe(row,col))
        {
            board[row][col]=1;

            solve(row+1);

            board[row][col]=0;
        }
    }
}

int main()
{
    printf("Enter N: ");
    scanf("%d",&n);

    solve(0);

    return 0;
}
